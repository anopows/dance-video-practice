# Install as /etc/choreo.env, owned by root, mode 0600. Never commit real values.
CHOREO_ORIGIN=https://fivesix.example.com
CHOREO_STATE_DIR=/var/lib/choreo
CHOREO_PASSWORD_HASH=
CHOREO_TURNSTILE_SITE_KEY=
CHOREO_TURNSTILE_SECRET=
CHOREO_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CHOREO_R2_BUCKET=choreo-practice
CHOREO_R2_ACCESS_KEY=
CHOREO_R2_SECRET_KEY=
CHOREO_RETENTION_SECONDS=7776000

# Multi-user launch. Generate SECRET_KEY once; keep it stable across releases.
CHOREO_SECRET_KEY=
CHOREO_ADMIN_EMAIL=admin@example.com
CHOREO_ABUSE_EMAIL=abuse@example.com
CHOREO_LEGAL_DIR=/etc/choreo/legal
CHOREO_SIGNUP_CAP=100
CHOREO_SMTP_HOST=
CHOREO_SMTP_PORT=587
CHOREO_SMTP_USER=
CHOREO_SMTP_PASSWORD=
CHOREO_MAIL_FROM=
CHOREO_GOOGLE_CLIENT_ID=
CHOREO_GOOGLE_CLIENT_SECRET=
CHOREO_R2_GUARD_ENABLED=true
CHOREO_R2_WEBHOOK_SECRET=
CHOREO_R2_ACCOUNT_ID=
CHOREO_R2_BUDGET_POLICY_ID=
CHOREO_STORAGE_CAP_BYTES=2000000000000
CHOREO_PROJECT_EGRESS_DAY_BYTES=50000000000
CHOREO_USER_UPLOADS_DAY=5
CHOREO_USER_UPLOADS_MONTH=20
CHOREO_IP_UPLOADS_DAY=15
CHOREO_SITE_UPLOADS_DAY=150
CHOREO_SITE_UPLOAD_BYTES_DAY=10000000000
CHOREO_ANALYZE_QUEUE_LIMIT=10
CHOREO_EMAIL_DAILY_CAP=90
CHOREO_SESSION_SECONDS=2592000

[Unit]
Description=Choreo practice API
After=network-online.target
Wants=network-online.target

[Service]
User=choreo
Group=choreo
WorkingDirectory=/opt/choreo
EnvironmentFile=/etc/choreo.env
ExecStart=/opt/choreo/.venv/bin/uvicorn choreo.api:create_app --factory --host 127.0.0.1 --port 18793 --workers 1 --no-access-log --no-proxy-headers --limit-concurrency 200 --timeout-keep-alive 10
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/choreo
MemoryMax=768M
TasksMax=128
LimitNOFILE=1024
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

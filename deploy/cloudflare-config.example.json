{
  "account_id": "YOUR_CLOUDFLARE_ACCOUNT_ID",
  "origin": "https://fivesix.example.com",
  "hostname": "fivesix.example.com",
  "bucket": "choreo-practice",
  "location_hint": "weur",
  "public_access": false,
  "turnstile": {
    "name": "five·six",
    "domains": [
      "fivesix.example.com"
    ],
    "mode": "managed",
    "clearance_level": "no_clearance"
  },
  "cors": {
    "rules": [
      {
        "id": "practice-playback",
        "allowed": {
          "origins": [
            "https://fivesix.example.com"
          ],
          "methods": [
            "GET",
            "HEAD"
          ],
          "headers": [
            "Range"
          ]
        },
        "exposeHeaders": [
          "Content-Length",
          "Content-Range",
          "ETag"
        ],
        "maxAgeSeconds": 3600
      }
    ]
  },
  "lifecycle": {
    "rules": [
      {
        "id": "practice-retention-backstop",
        "enabled": true,
        "conditions": {
          "prefix": ""
        },
        "deleteObjectsTransition": {
          "condition": {
            "type": "Age",
            "maxAge": 7776000
          }
        },
        "abortMultipartUploadsTransition": {
          "condition": {
            "type": "Age",
            "maxAge": 86400
          }
        }
      }
    ]
  }
}
